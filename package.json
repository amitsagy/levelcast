{
  "name": "levelcast-site",
  "version": "1.0.0",
  "description": "LevelCast marketing site (Eleventy, Hebrew + English)",
  "scripts": {
    "build": "node scripts/build-assets.mjs && eleventy",
    "dev": "node scripts/build-assets.mjs && eleventy --serve",
    "verify": "node scripts/verify.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitsagy/levelcast.git"
  },
  "type": "module",
  "homepage": "https://github.com/amitsagy/levelcast#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lightningcss": "^1.33.0",
    "playwright": "^1.63.0",
    "wrangler": "^4.145.0"
  },
  "private": "true"
}
